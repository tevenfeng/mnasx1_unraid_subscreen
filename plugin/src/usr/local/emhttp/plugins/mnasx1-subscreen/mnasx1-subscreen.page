      <select id="layout" name="layout">
        <option value="per-page" <?=$cfg['layout'] === 'per-page' ? 'selected' : ''?>>一页一卡 per-page</option>
        <option value="paired" <?=$cfg['layout'] === 'paired' ? 'selected' : ''?>>两块一页 paired</option>
      </select>
    </div>
    <div class="subsys-row">
      <label for="syscount">卡片数量 / Cards</label>
      <select id="syscount" name="syscount">
        <option value="auto" <?=$cfg['syscount'] === 'auto' ? 'selected' : ''?>>自动 auto</option>
        <option value="3" <?=$cfg['syscount'] === '3' ? 'selected' : ''?>>3</option>
        <option value="4" <?=$cfg['syscount'] === '4' ? 'selected' : ''?>>4</option>
      </select>
    </div>
    <div class="subsys-row">
      <label for="wlan_slots">网卡槽位 / Adapter slots</label>
      <select id="wlan_slots" name="wlan_slots">
        <?php foreach ([1, 2, 3] as $slots): ?>
        <option value="<?=$slots?>" <?=(string)$slots === $cfg['wlan_slots'] ? 'selected' : ''?>><?=$slots?></option>
        <?php endforeach; ?>
      </select>
    </div>
    <div class="subsys-row">
      <label for="wlan_total_unit">累计流量单位 / Traffic unit</label>
      <select id="wlan_total_unit" name="wlan_total_unit">
        <?php foreach (['auto', 'kb', 'mb', 'gb', 'tb'] as $unit): ?>
        <option value="<?=$unit?>" <?=$cfg['wlan_total_unit'] === $unit ? 'selected' : ''?>><?=$unit?></option>
        <?php endforeach; ?>
      </select>
    </div>
  </div>

  <p class="subsys-hint">卡片顺序 / Card order（四个槽位各选一张，不能重复）</p>
  <div class="subsys-grid">
    <?php foreach (['slot1', 'slot2', 'slot3', 'slot4'] as $index => $slot): ?>
    <div class="subsys-row">
      <label for="<?=$slot?>">槽位 <?=$index + 1?></label>
      <select id="<?=$slot?>" name="<?=$slot?>">
        <?php foreach ($labels as $value => $text): ?>
        <option value="<?=$value?>" <?=(($order[$index] ?? '') === $value) ? 'selected' : ''?>><?=$text?></option>
        <?php endforeach; ?>
      </select>
    </div>
    <?php endforeach; ?>
  </div>

  <p class="subsys-hint">高级 / Advanced：页面块是否携带数值。默认 both 最接近实测可用的行为。 / Whether the page blocks also carry values.</p>
  <div class="subsys-grid">
    <div class="subsys-row">
      <label for="system_mode">数值通道 / Value channel</label>
      <select id="system_mode" name="system_mode">
        <?php foreach (['both', 'vendor', 'legacy'] as $mode): ?>
        <option value="<?=$mode?>" <?=$cfg['system_mode'] === $mode ? 'selected' : ''?>><?=$mode?></option>
        <?php endforeach; ?>
      </select>
    </div>
  </div>
</div>

<div class="subsys-card">
  <h3>数据源 / Data sources</h3>

  <p class="subsys-hint">磁盘 / Disks（不勾选「自动」时只上报勾选的挂载点，最多 8 个）</p>
  <label style="display:block;margin-bottom:6px">
    <input type="checkbox" name="auto_disks" value="1" <?=$autoDisks ? 'checked' : ''?>
           onchange="document.querySelectorAll('input.subsys-disk').forEach(function(el){el.disabled=this.checked;}, this)">
    自动发现 / Auto-discover
  </label>
  <div class="subsys-grid">
    <?php foreach ($disks as $mount): ?>
    <label class="subsys-disk">
      <input type="checkbox" class="subsys-disk" name="disks[]" value="<?=subsys_h($mount)?>"
             <?=in_array($mount, $configuredDisks, true) ? 'checked' : ''?>
             <?=$autoDisks ? 'disabled' : ''?>>
      <?=subsys_h($mount)?>
    </label>
    <?php endforeach; ?>
  </div>

  <p class="subsys-hint">
    勾选「自动」时按挂载点自动发现；取消自动后一个都不勾选，等同自动。<br>
    Auto-discover follows the mounts; leaving manual selection empty also means auto.
  </p>

  <p class="subsys-hint" style="margin-top:12px">网卡 / Interfaces（持有 IPv4 的接口）</p>
  <label style="display:block;margin-bottom:6px">
    <input type="checkbox" name="auto_ifaces" value="1" <?=$autoIfaces ? 'checked' : ''?>
           onchange="document.querySelectorAll('input.subsys-iface').forEach(function(el){el.disabled=this.checked;}, this)">
    自动发现 / Auto-discover
  </label>
  <div class="subsys-grid">
    <?php foreach ($ifaces as $iface): ?>
    <label class="subsys-iface">
      <input type="checkbox" class="subsys-iface" name="ifaces[]" value="<?=subsys_h($iface)?>"
             <?=in_array($iface, $configuredIfaces, true) ? 'checked' : ''?>
             <?=$autoIfaces ? 'disabled' : ''?>>
      <?=subsys_h($iface)?>
    </label>
    <?php endforeach; ?>
  </div>

  <div class="subsys-grid" style="margin-top:12px">
    <?php
    $toggles = [
        ['gpu', '启用 GPU 卡 / GPU cards'],
        ['gpu_igpu', '  └ 核显 / iGPU'],
        ['gpu_dgpu', '  └ 独显 / DGPU'],
        ['nvidia_smi', '  └ 使用 nvidia-smi'],
        ['temp_hwmon', '温度来源 / Temp: hwmon'],
        ['temp_smartctl', '  └ smartctl'],
        ['temp_disksini', '  └ disks.ini'],
        ['wake_disks', '允许唤醒休眠盘 / Wake sleeping disks'],
        ['log_verbose', '详细日志 / Verbose log'],
    ];
    foreach ($toggles as [$key, $label]): ?>
    <div class="subsys-row">
      <label><?=$label?></label>
      <input type="hidden" name="<?=$key?>" value="0">
      <input type="checkbox" name="<?=$key?>" value="1" <?=$cfg[$key] === '1' ? 'checked' : ''?>>
    </div>
    <?php endforeach; ?>
  </div>
  <p class="subsys-hint">
    关闭 nvidia-smi 后 NVIDIA 卡不会有任何读数；关闭全部温度来源会被强制保留 hwmon 一个。<br>
