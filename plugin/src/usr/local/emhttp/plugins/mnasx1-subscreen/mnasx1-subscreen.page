<?php
require_once '/usr/local/emhttp/plugins/mnasx1-subscreen/include/lib.php';

$cfg = subsys_read_config();
$running = subsys_daemon_running();
$python = subsys_python();
$pythonOk = $python !== '' && is_executable($python);
$note = (string)($_GET['note'] ?? '');
$error = (string)($_GET['error'] ?? '');
$output = (string)($_GET['output'] ?? '');

$disks = subsys_discover_disks();
$ifaces = subsys_discover_ifaces();
$configuredDisks = $cfg['disks'] === '' ? $disks : array_filter(array_map('trim', explode(',', $cfg['disks'])));
$configuredIfaces = $cfg['ifaces'] === '' ? $ifaces : array_filter(array_map('trim', explode(',', $cfg['ifaces'])));
$autoDisks = $cfg['disks'] === '';
$autoIfaces = $cfg['ifaces'] === '';
$order = array_pad(array_filter(array_map('trim', explode(',', $cfg['card_order']))), 4, '');
$version = is_readable(SUBSYS_APP_DIR . '/VERSION')
    ? trim((string)file_get_contents(SUBSYS_APP_DIR . '/VERSION')) : 'unknown';
$logTail = [];
if (is_readable('/var/log/mnasx1-subscreen.log')) {
    $logTail = array_slice(file('/var/log/mnasx1-subscreen.log', FILE_IGNORE_NEW_LINES) ?: [], -6);
}
$labels = ['cpu' => 'CPU', 'igpu' => '核显 iGPU', 'mem' => '内存 Memory', 'dgpu' => '独显 DGPU'];
?>

<style>
  .subsys-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px 24px; }
  .subsys-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 0; }
  .subsys-row label:first-child { flex: 1 1 auto; }
  .subsys-row input[type=number], .subsys-row select { width: 120px; }
  .subsys-hint { color: #888; font-size: 11px; margin: -2px 0 8px; }
  .subsys-bad { color: #c33; font-weight: bold; }
  .subsys-ok { color: #2a7; font-weight: bold; }
  .subsys-card { border: 1px solid #ddd; border-radius: 6px; padding: 10px 14px; margin-bottom: 14px; }
  .subsys-card h3 { margin: 0 0 8px; }
  pre.subsys-log { max-height: 120px; overflow: auto; background: #f7f7f7; padding: 8px; font-size: 11px; }
</style>

<?php if ($error !== ''): ?>
<div class="subsys-card" style="border-color:#c33">
  <span class="subsys-bad">错误 / Error:</span> <?=subsys_h($error)?>
</div>
<?php elseif ($note !== ''): ?>
<div class="subsys-card" style="border-color:#2a7">
  <span class="subsys-ok">已保存 / Saved.</span>
  <?php if ($output !== ''): ?><br><small><?=subsys_h($output)?></small><?php endif; ?>
</div>
<?php endif; ?>

<div class="subsys-card">
  <h3>状态 / Status</h3>
  <div class="subsys-grid">
    <div class="subsys-row">
      <span>守护进程 / Daemon</span>
      <span class="<?=$running ? 'subsys-ok' : 'subsys-bad'?>"><?=$running ? '运行中 running' : '已停止 stopped'?></span>
    </div>
    <div class="subsys-row">
      <span>Python（≥ 3.7）</span>
      <span class="<?=$pythonOk ? 'subsys-ok' : 'subsys-bad'?>">
        <?=$pythonOk ? subsys_h(basename($python)) : '缺失 missing'?>
      </span>
    </div>
    <div class="subsys-row">
      <span>插件版本 / Plugin</span>
      <span><?=subsys_h($version)?></span>
    </div>
    <div class="subsys-row">
      <span>配置 / Config</span>
      <span><small><?=subsys_h(SUBSYS_CONFIG)?></small></span>
    </div>
  </div>
  <?php if (!$pythonOk): ?>
  <p class="subsys-bad">
    Unraid 基础系统不含 Python。请先安装 NerdTools 或 Python 3 插件，否则守护进程无法启动。<br>
    Unraid ships no Python: install NerdTools or a Python 3 plugin first.
  </p>
  <?php endif; ?>
  <?php if ($logTail): ?>
  <pre class="subsys-log"><?=subsys_h(implode("\n", $logTail))?></pre>
  <?php endif; ?>

  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
    <?php foreach ([['start', '启动 Start'], ['stop', '停止 Stop'],
                    ['restart', '重启 Restart'], ['once', '推送一帧 Push once'],
                    ['reset', '复位 USB Reset']] as [$cmd, $label]): ?>
    <form method="post" action="/plugins/mnasx1-subscreen/include/action.php" style="margin:0">
      <input type="hidden" name="action" value="<?=$cmd?>">
      <button type="submit" <?=($cmd === 'start' && !$pythonOk) ? 'disabled' : ''?>><?=$label?></button>
    </form>
    <?php endforeach; ?>
    <a class="button" href="/plugins/mnasx1-subscreen/include/diagnose.php">下载诊断 / Diagnostics</a>
  </div>
  <p class="subsys-hint">「推送一帧」与「复位 USB」需要先停止守护进程（USB 端口只能被一个进程占用）。 / Push-once and Reset need the daemon stopped: only one process can own the USB interface.</p>
</div>

<form method="post" action="/plugins/mnasx1-subscreen/include/save.php">

<div class="subsys-card">
  <h3>刷新节奏 / Refresh cadence</h3>
  <div class="subsys-grid">
    <div class="subsys-row">
      <label for="pace">发送间隔 / Packet gap（秒）</label>
      <input id="pace" type="number" name="pace" step="0.1" min="0.5" max="5"
             value="<?=subsys_h($cfg['pace'])?>">
    </div>
    <div class="subsys-row">
      <label for="every_fast">实时值 / fast（每 N 帧）</label>
      <input id="every_fast" type="number" name="every_fast" min="1" max="60"
             value="<?=subsys_h($cfg['every_fast'])?>">
    </div>
    <div class="subsys-row">
      <label for="every_medium">时间与网卡 / medium</label>
      <input id="every_medium" type="number" name="every_medium" min="1" max="60"
             value="<?=subsys_h($cfg['every_medium'])?>">
    </div>
    <div class="subsys-row">
      <label for="every_slow">磁盘与流量 / slow</label>
      <input id="every_slow" type="number" name="every_slow" min="1" max="60"
             value="<?=subsys_h($cfg['every_slow'])?>">
    </div>
    <div class="subsys-row">
      <label for="every_static">静态页 / static</label>
      <input id="every_static" type="number" name="every_static" min="1" max="60"
             value="<?=subsys_h($cfg['every_static'])?>">
    </div>
  </div>
  <p class="subsys-hint">
    每包等待时间。实测低于 1.0 秒会积压并让面板卡死（按键也失效），0.5 是下限而不是建议值。<br>
    Time between packets. Below 1.0 s the panel builds a backlog, freezes and stops taking input.
